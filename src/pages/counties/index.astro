---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CountyExplorer from '../../components/CountyExplorer';
import { KENYA_47_COUNTIES, PUBLIC_INSTITUTIONS } from '../../data/publicInstitutions';
---

<BaseLayout
  title="47-County & Regional Academic Ledger | schologic.org"
  description="Explore Kenyan higher and technical education distribution across all 47 counties and 8 regions."
  activeNav="counties"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <header class="border-b border-hairline pb-6 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <p class="font-mono text-[11px] uppercase tracking-widest text-forest font-semibold">
          National Geographic Index
        </p>
        <h1 class="font-serif text-3xl sm:text-4xl font-semibold text-ink mt-1.5">
          Kenya 47-County &amp; Regional Ledger
        </h1>
        <p class="mt-2 text-sm sm:text-base text-muted max-w-2xl leading-relaxed">
          Track university, TVET, National Polytechnic, and KMTC presence across Kenya’s 47
          counties and 8 regions.
        </p>
      </div>

      <a
        href="/"
        class="px-3.5 py-2 border border-hairline bg-limestone/50 text-xs font-semibold text-ink hover:border-ink transition-colors whitespace-nowrap self-start md:self-auto"
      >
        ← Full Institution Directory
      </a>
    </header>

    <CountyExplorer
      allCounties={KENYA_47_COUNTIES}
      institutions={PUBLIC_INSTITUTIONS}
      client:load
    />
  </div>
</BaseLayout>
