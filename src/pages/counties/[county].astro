---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getIndexedCounties } from '../../data/publicInstitutions';
import { formatCategoryLabel, formatTypeLabel } from '../../types/institution';

export function getStaticPaths() {
  return getIndexedCounties().map((entry) => ({
    params: { county: entry.countySlug },
    props: { countyEntry: entry },
  }));
}

const { countyEntry } = Astro.props;
const compareIds = countyEntry.institutions
  .slice(0, 4)
  .map((i) => i.slug)
  .join(',');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `Accredited Institutions in ${countyEntry.county} County, Kenya`,
  description: `Indexed universities, TVETs, and KMTC campuses located in ${countyEntry.county} County (${countyEntry.region} Region).`,
};
---

<BaseLayout
  title={`${countyEntry.county} County Academic Institutions | schologic.org`}
  description={`Browse ${countyEntry.institutions.length} indexed universities, TVETs, and KMTC campuses in ${countyEntry.county} County, Kenya.`}
  activeNav="counties"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <nav aria-label="Breadcrumb" class="font-mono text-xs text-muted flex items-center gap-2">
      <a href="/" class="hover:text-forest hover:underline">Map &amp; Rankings</a>
      <span>/</span>
      <a href="/counties" class="hover:text-forest hover:underline">47-County Ledger</a>
      <span>/</span>
      <span class="text-ink font-medium">{countyEntry.county} County</span>
    </nav>

    <header class="border-b border-hairline pb-6 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <p class="font-mono text-[11px] uppercase tracking-widest text-forest font-semibold">
          {countyEntry.region} Region · County Dossier
        </p>
        <h1 class="font-serif text-3xl sm:text-4xl font-semibold text-ink mt-1.5">
          {countyEntry.county} County Institutions
        </h1>
        <p class="mt-2 text-sm sm:text-base text-muted">
          <span class="font-mono font-semibold text-ink tabular-nums">
            {countyEntry.institutions.length}
          </span>{' '}
          indexed institutions ·{' '}
          <span class="font-mono font-semibold text-forest tabular-nums">
            {countyEntry.verifiedCount}
          </span>{' '}
          verified in registry.
        </p>
      </div>

      {countyEntry.institutions.length > 1 && (
        <a
          href={`/compare?ids=${encodeURIComponent(compareIds)}`}
          class="px-4 py-2.5 bg-forest text-paper text-xs font-semibold hover:bg-ink transition-colors whitespace-nowrap self-start md:self-auto"
        >
          Compare {countyEntry.county} Institutions →
        </a>
      )}
    </header>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {countyEntry.institutions.map((inst) => (
        <article class="border border-hairline bg-paper p-6 flex flex-col justify-between gap-4">
          <div>
            <div class="flex items-start gap-3.5">
              {inst.logo_url && (
                <div class="w-12 h-12 shrink-0 border border-hairline bg-white flex items-center justify-center p-1 overflow-hidden">
                  <img
                    src={inst.logo_url}
                    alt={`${inst.name} logo`}
                    loading="lazy"
                    referrerPolicy="no-referrer"
                    class="w-full h-full object-contain"
                    onerror="this.parentElement.style.display='none'"
                  />
                </div>
              )}
              <div class="min-w-0 flex-1">
                <div class="font-mono text-[11px] text-muted flex flex-wrap items-center gap-2">
                  <span class="text-forest font-semibold uppercase">{formatTypeLabel(inst.type)}</span>
                  <span>·</span>
                  <span class="capitalize">{inst.ownership}</span>
                  <span>·</span>
                  <span>{inst.town}</span>
                </div>

                <h2 class="font-serif text-2xl font-semibold text-ink mt-1">
                  <a href={`/institutions/${inst.slug}`} class="hover:text-forest hover:underline">
                    {inst.name}
                  </a>
                </h2>
              </div>
            </div>

            <p class="mt-3 text-sm text-muted leading-relaxed line-clamp-2">{inst.description}</p>

            <dl class="mt-4 pt-3 border-t border-hairline grid grid-cols-3 gap-3 text-xs">
              <div>
                <dt class="text-muted">Classification</dt>
                <dd class="font-medium text-ink mt-0.5 truncate">
                  {inst.category ?? formatCategoryLabel(inst.category)}
                </dd>
              </div>
              <div>
                <dt class="text-muted">Composite Score</dt>
                <dd class="font-mono font-semibold text-forest tabular-nums mt-0.5">
                  {inst.ranking_scores.composite} / 100
                </dd>
              </div>
              <div>
                <dt class="text-muted">Courses</dt>
                <dd class="font-mono font-semibold text-ink tabular-nums mt-0.5">
                  {inst.total_courses_count} tracked
                </dd>
              </div>
            </dl>
          </div>

          <div class="pt-3 border-t border-hairline flex flex-wrap items-center justify-between gap-2 text-xs">
            <a
              href={inst.google_maps_url}
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono text-lapis hover:underline"
            >
              Google Maps ↗
            </a>
            <a
              href={`/institutions/${inst.slug}`}
              class="font-semibold text-forest hover:underline"
            >
              View Full Profile →
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</BaseLayout>
