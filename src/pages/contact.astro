---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm';
---

<BaseLayout
  title="Contact & Registry Updates | schologic.org"
  description="Contact the schologic.org team for Kenyan institution profile updates, verification requests, student/educator support, or institutional partnerships."
  activeNav="contact"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12 space-y-10">
    <header class="border-b border-hairline pb-6 grid grid-cols-1 lg:grid-cols-12 gap-6 items-end">
      <div class="lg:col-span-8">
        <p class="font-mono text-[11px] uppercase tracking-widest text-forest font-semibold">
          Contact &amp; Public Registry Desk
        </p>
        <h1 class="font-serif text-3xl sm:text-4xl font-semibold text-ink mt-1.5 text-balance">
          Questions, Institution Corrections &amp; Verification Support
        </h1>
        <p class="mt-2 text-sm sm:text-base text-muted max-w-2xl leading-relaxed">
          Reach out to update an institution’s accredited courses, request verification on a Kenyan
          university/TVET/KMTC profile, or get help onboarding your department.
        </p>
      </div>

      <div class="lg:col-span-4 lg:text-right text-xs text-muted">
        <span class="font-mono uppercase tracking-wider text-ink font-semibold block">
          Nairobi, Kenya
        </span>
        <span>Kenya Data Protection Act (2019) Compliant Desk</span>
      </div>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-7">
        <ContactForm client:load />
      </div>

      <aside class="lg:col-span-5 space-y-5 text-sm">
        <div class="border border-hairline bg-paper p-6 space-y-4">
          <h2 class="font-serif text-xl font-semibold text-ink pb-2 border-b border-hairline">
            Correspondence Directory
          </h2>

          <div class="space-y-4 text-xs leading-relaxed">
            <div>
              <span class="font-mono uppercase tracking-wider text-forest font-semibold block">
                1. Institutional Profile Updates
              </span>
              <p class="text-muted mt-1">
                Registrars, Principals, and ICT Directors can submit updated CUE/TVETA
                registration codes, campus addresses, or accredited programme lists for review.
              </p>
            </div>

            <div class="pt-3 border-t border-hairline">
              <span class="font-mono uppercase tracking-wider text-lapis font-semibold block">
                2. Students &amp; Practitioners
              </span>
              <p class="text-muted mt-1">
                Need help accessing OER resources, setting up Practicum Manager cohorts, or logging
                into your campus workspace? Use the inquiry form or visit{' '}
                <a href="/login" class="text-forest font-semibold hover:underline">
                  Account Login
                </a>
                .
              </p>
            </div>

            <div class="pt-3 border-t border-hairline">
              <span class="font-mono uppercase tracking-wider text-ink font-semibold block">
                3. Institutional B2B Procurement &amp; Demos
              </span>
              <p class="text-muted mt-1">
                For enterprise licensing, custom domains, and vetted institutional evaluations,
                contact our enterprise desk directly on{' '}
                <a
                  href="https://schologic.com/contact"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-lapis underline"
                >
                  schologic.com/contact ↗
                </a>{' '}
                or{' '}
                <a
                  href="https://schologic.com/demo"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-lapis underline"
                >
                  schologic.com/demo ↗
                </a>
                .
              </p>
            </div>
          </div>
        </div>

        <div class="border border-hairline bg-limestone/40 p-5 text-xs text-muted space-y-2 leading-relaxed">
          <p class="font-mono uppercase tracking-wider text-ink font-semibold">
            Data Hygiene &amp; Privacy Notice
          </p>
          <p>
            In compliance with the Kenya Data Protection Act (2019), <code class="font-mono">schologic.org</code>{' '}
            publishes only official institutional registry metadata and never displays personal
            staff contact details.
          </p>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
