---
import BaseLayout from '../layouts/BaseLayout.astro';
import FreeTierOnboarding from '../components/FreeTierOnboarding';
import { PUBLIC_INSTITUTIONS } from '../data/publicInstitutions';
---

<BaseLayout
  title="Free-Tier Campus Onboarding (*.schologic.org) | schologic.org"
  description="Activate a free-tier Class Manager, OER Library, AI Assistant, and Practicum Manager workspace on yourcampus.schologic.org."
  activeNav="start"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <header class="border-b border-hairline pb-6 grid grid-cols-1 lg:grid-cols-12 gap-6 items-end">
      <div class="lg:col-span-8">
        <p class="font-mono text-[11px] uppercase tracking-widest text-forest font-semibold">
          Bottom-Up Practitioner Onboarding
        </p>
        <h1 class="font-serif text-3xl sm:text-4xl font-semibold text-ink mt-1.5 text-balance">
          Activate a Free <code class="font-mono text-forest">*.schologic.org</code> Campus Workspace
        </h1>
        <p class="mt-2 text-sm sm:text-base text-muted max-w-2xl leading-relaxed">
          Individual lecturers, TVET trainers, and clinical/teaching practicum coordinators can
          start immediately without procurement delays. One system for the work behind learning.
        </p>
      </div>

      <div class="lg:col-span-4 lg:text-right text-xs text-muted space-y-1">
        <p class="font-mono uppercase tracking-wider text-ink font-semibold">
          Institutional Decision-Makers
        </p>
        <p>
          Need vetted multi-campus SSO &amp; custom domains?{' '}
          <a
            href="https://schologic.com/demo"
            target="_blank"
            rel="noopener noreferrer"
            class="text-lapis underline"
          >
            schologic.com/demo
          </a>{' '}
          or{' '}
          <a
            href="https://demo.schologic.study"
            target="_blank"
            rel="noopener noreferrer"
            class="text-lapis underline"
          >
            demo.schologic.study
          </a>
        </p>
      </div>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <div class="lg:col-span-8">
        <FreeTierOnboarding institutions={PUBLIC_INSTITUTIONS} client:load />
      </div>

      <aside class="lg:col-span-4 border border-hairline bg-limestone/40 p-6 space-y-4 text-xs">
        <p class="font-mono uppercase tracking-widest text-muted">
          Included on Every Free Subdomain
        </p>
        <ul class="space-y-3 text-ink leading-relaxed">
          <li>
            <strong class="block font-serif text-sm">Class Manager</strong>
            Structured unit modules, assignment deadlines, and calm cohort gradebooks.
          </li>
          <li>
            <strong class="block font-serif text-sm">AI Assistant &amp; Advisory Detection</strong>
            Cut grading turnaround while reviewing measured integrity signals.
          </li>
          <li>
            <strong class="block font-serif text-sm">OER Library &amp; Universal Reader</strong>
            Zero-cost open textbooks readable across student phones and campus labs.
          </li>
          <li>
            <strong class="block font-serif text-sm">Practicum Manager</strong>
            Track TVET industrial attachments, teaching practice, and KMTC clinical rotations.
          </li>
        </ul>
      </aside>
    </div>
  </div>
</BaseLayout>
