---
import BaseLayout from '../layouts/BaseLayout.astro';
import DirectoryExplorer from '../components/DirectoryExplorer';
import { CURATED_INSTITUTION_SUMMARIES, PUBLIC_INSTITUTIONS } from '../data/publicInstitutions';

const totalInstitutions = PUBLIC_INSTITUTIONS.length;
const uniCount = PUBLIC_INSTITUTIONS.filter((i) => i.type === 'university').length;
const tvetCount = PUBLIC_INSTITUTIONS.filter((i) => i.type === 'tvet').length;
const kmtcCount = PUBLIC_INSTITUTIONS.filter((i) => i.type === 'kmtc').length;
---

<BaseLayout
  title="Full Institution Directory (2,300+ Kenyan Colleges & Universities) | schologic.org"
  description="Search, filter, and compare all indexed Kenyan universities, National Polytechnics, TVETs, and KMTC campuses with direct Google Maps links and Schologic LMS workspaces."
  activeNav="directory"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <header class="border-b border-hairline pb-6 flex flex-col lg:flex-row lg:items-end justify-between gap-4">
      <div>
        <p class="font-mono text-[11px] uppercase tracking-widest text-forest font-semibold">
          Complete Searchable Registry
        </p>
        <h1 class="font-serif text-3xl sm:text-4xl font-semibold text-ink mt-1.5">
          Kenyan Institutions Directory
        </h1>
        <p class="mt-2 text-sm sm:text-base text-muted max-w-2xl leading-relaxed">
          Browse <strong class="text-ink">{totalInstitutions.toLocaleString()}</strong> active
          institutions ({uniCount} Universities · {tvetCount.toLocaleString()} TVETs · {kmtcCount}{' '}
          KMTC campuses) across all 47 counties, inspect Google Maps coordinates, and pin any four
          for comparison.
        </p>
      </div>

      <a
        href="/"
        class="px-3.5 py-2 border border-hairline bg-limestone/50 text-xs font-semibold text-ink hover:border-ink transition-colors whitespace-nowrap self-start md:self-auto"
      >
        ← Return to Map &amp; Rankings
      </a>
    </header>

    <DirectoryExplorer initialInstitutions={CURATED_INSTITUTION_SUMMARIES} client:load />
  </div>
</BaseLayout>
