---
import BaseLayout from '../layouts/BaseLayout.astro';
import LoginGateway from '../components/LoginGateway';
---

<BaseLayout
  title="Login — Schologic LMS & Campus Workspace | schologic.org"
  description="Sign in to your Schologic LMS student, instructor, or institutional workspace."
  activeNav="login"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-6 space-y-5">
        <div class="flex items-center gap-3">
          <img
            src="/images/schologic-logo.png"
            alt="Schologic LMS"
            width="36"
            height="36"
            class="w-9 h-9 object-contain"
          />
          <span class="font-mono text-xs uppercase tracking-widest text-forest font-semibold">
            Schologic LMS Router
          </span>
        </div>

        <h1 class="font-serif text-3xl sm:text-4xl font-semibold text-ink leading-tight text-balance">
          Sign in to your Schologic LMS workspace.
        </h1>

        <p class="text-base text-muted leading-relaxed max-w-xl">
          Access your courses, Universal Reader textbooks, Practicum Manager logs, and instructor
          grading tools on Schologic LMS. Existing institutional authentication and subdomain routing
          connect directly through this gateway.
        </p>

        <div class="border-t border-hairline pt-5 grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
          <div class="border border-hairline bg-limestone/35 p-4 space-y-1">
            <span class="font-mono uppercase tracking-wider text-muted block">
              Students &amp; Lecturers
            </span>
            <p class="text-ink leading-relaxed">
              Sign in with your academic email or look up your campus subdomain to continue.
            </p>
          </div>
          <div class="border border-hairline bg-limestone/35 p-4 space-y-1">
            <span class="font-mono uppercase tracking-wider text-muted block">
              Institution Admins
            </span>
            <p class="text-ink leading-relaxed">
              Managing seats or billing? Visit{' '}
              <a
                href="https://console.schologic.com"
                target="_blank"
                rel="noopener noreferrer"
                class="text-lapis font-semibold hover:underline"
              >
                console.schologic.com ↗
              </a>
            </p>
          </div>
        </div>
      </div>

      <div class="lg:col-span-6 max-w-lg w-full lg:ml-auto">
        <LoginGateway client:load />
      </div>
    </div>
  </div>
</BaseLayout>
