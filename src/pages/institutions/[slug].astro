---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InstitutionCompareIsland from '../../components/InstitutionCompareIsland';
import { PUBLIC_INSTITUTIONS } from '../../data/publicInstitutions';
import {
  formatCategoryLabel,
  formatTypeLabel,
  slugifyCounty,
} from '../../types/institution';

export function getStaticPaths() {
  return PUBLIC_INSTITUTIONS.map((inst) => ({
    params: { slug: inst.slug },
    props: { institution: inst },
  }));
}

const { institution } = Astro.props;

const countySlug = slugifyCounty(institution.county);
const portalHost = institution.custom_portal_domain ?? institution.portal_subdomain;

const nameWords = institution.name
  .replace(/[^A-Za-z0-9\s]/g, ' ')
  .split(/\s+/)
  .filter((w) => w.length > 0 && !['of', 'and', 'the', 'for', 'in', 'at'].includes(w.toLowerCase()));
const initials =
  nameWords.length <= 1
    ? (nameWords[0] ?? 'KE').slice(0, 3).toUpperCase()
    : nameWords
        .slice(0, 3)
        .map((w) => w[0])
        .join('')
        .toUpperCase();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  name: institution.name,
  alternateName: institution.aliases,
  url: institution.website ?? `https://schologic.org/institutions/${institution.slug}`,
  hasMap: institution.google_maps_url,
  description: institution.description,
  address: {
    '@type': 'PostalAddress',
    addressLocality: institution.town,
    addressRegion: institution.county,
    addressCountry: 'KE',
    streetAddress: institution.location,
  },
};
---

<BaseLayout
  title={`${institution.name} — Kenya Academic Profile | schologic.org`}
  description={institution.description}
  activeNav="directory"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10 space-y-8">
    <!-- Breadcrumb -->
    <nav aria-label="Breadcrumb" class="font-mono text-xs text-muted flex flex-wrap items-center gap-2">
      <a href="/" class="hover:text-forest hover:underline">Map &amp; Rankings</a>
      <span>/</span>
      <a href="/directory" class="hover:text-forest hover:underline">Directory</a>
      <span>/</span>
      <a href={`/counties/${countySlug}`} class="hover:text-forest hover:underline">
        {institution.county} County
      </a>
      <span>/</span>
      <span class="text-ink font-medium">{institution.name}</span>
    </nav>

    <!-- Monograph Header with Institutional Logo Crest & Google Maps -->
    <header class="border border-hairline bg-paper p-6 sm:p-8 space-y-6">
      <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-6">
        <div class="flex items-start gap-5 flex-1">
          <!-- Institutional Logo Crest (real logo_url with monogram fallback) -->
          <div class="w-20 h-20 sm:w-24 sm:h-24 shrink-0 border border-hairline bg-white flex items-center justify-center overflow-hidden p-2">
            {institution.logo_url ? (
              <>
                <img
                  src={institution.logo_url}
                  alt={`${institution.name} official logo`}
                  referrerPolicy="no-referrer"
                  class="w-full h-full object-contain"
                  onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
                />
                <div
                  style="display:none"
                  class="w-full h-full items-center justify-center bg-limestone/60 font-mono text-lg font-bold tracking-wider text-ink"
                >
                  {initials}
                </div>
              </>
            ) : (
              <div class="w-full h-full flex items-center justify-center bg-limestone/60 font-mono text-lg font-bold tracking-wider text-ink">
                {initials}
              </div>
            )}
          </div>

          <div class="min-w-0 flex-1">
            <div class="font-mono text-[11px] uppercase tracking-widest text-muted flex flex-wrap items-center gap-x-2 gap-y-1">
              <span class="text-forest font-semibold">{formatTypeLabel(institution.type)}</span>
              {institution.category && (
                <>
                  <span>·</span>
                  <span>{institution.category}</span>
                </>
              )}
              <span>·</span>
              <span class="capitalize">{institution.ownership}</span>
              <span>·</span>
              <span>{institution.registration_number ?? 'Registry Listed'}</span>
              {institution.is_verified && (
                <>
                  <span>·</span>
                  <span class="text-forest font-semibold">Verified Record</span>
                </>
              )}
            </div>

            <h1 class="font-serif text-3xl sm:text-4xl font-semibold text-ink mt-1.5 leading-tight text-balance">
              {institution.name}
            </h1>

            <p class="mt-2 font-mono text-xs text-muted">
              {institution.location}
              {institution.geo ? ` · ${institution.geo.lat.toFixed(4)}°, ${institution.geo.lng.toFixed(4)}°` : ''}
            </p>
          </div>
        </div>

        <!-- Primary External Actions: Google Maps + Website -->
        <div class="flex flex-wrap items-center gap-2.5 shrink-0">
          <a
            href={institution.google_maps_url}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-4 py-2.5 bg-forest text-paper text-xs sm:text-sm font-semibold hover:bg-ink transition-colors whitespace-nowrap"
          >
            {institution.has_verified_maps_url ? 'Open in Google Maps ↗' : 'Find on Google Maps ↗'}
          </a>

          {institution.website && (
            <a
              href={institution.website}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 px-4 py-2.5 border border-hairline bg-limestone/50 text-xs sm:text-sm font-semibold text-ink hover:border-ink transition-colors whitespace-nowrap"
            >
              Official Website ↗
            </a>
          )}
        </div>
      </div>

      <p class="text-base text-muted leading-relaxed max-w-4xl">
        {institution.description}
      </p>

      <!-- Schologic LMS Strip -->
      <div class="pt-4 border-t border-hairline flex flex-wrap items-center justify-between gap-4 text-xs">
        <div>
          <span class="font-mono uppercase tracking-wider text-muted block">
            Schologic LMS Portal Status
          </span>
          {portalHost ? (
            <a
              href={`https://${portalHost}`}
              target="_blank"
              rel="noopener noreferrer"
              class="font-mono text-sm font-semibold text-lapis hover:underline mt-0.5 inline-block"
            >
              {portalHost} (Schologic LMS) →
            </a>
          ) : (
            <a
              href={`/start?campus=${institution.slug}`}
              class="font-mono text-sm text-bronze hover:underline mt-0.5 inline-block"
            >
              Claim free {institution.slug}.schologic.org Schologic LMS portal →
            </a>
          )}
        </div>

        <div class="font-mono text-xs text-muted tabular-nums">
          Composite Index Score:{' '}
          <strong class="text-forest text-sm">{institution.ranking_scores.composite} / 100</strong>
        </div>
      </div>
    </header>

    <!-- 2-Column Monograph Body -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Left Column: Academic Dossier (8 cols) -->
      <div class="lg:col-span-8 space-y-8">
        <!-- About & Key Attributes -->
        <section class="border border-hairline bg-paper p-6 space-y-5">
          <div class="pb-3 border-b border-hairline">
            <p class="font-mono text-[11px] uppercase tracking-widest text-muted">
              Institutional Monograph
            </p>
            <h2 class="font-serif text-2xl font-semibold text-ink mt-0.5">
              Mandate &amp; Registry Metadata
            </h2>
          </div>

          <p class="text-sm sm:text-base text-ink/90 leading-relaxed">
            {institution.about}
          </p>

          <dl class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 pt-4 border-t border-hairline text-xs">
            <div>
              <dt class="font-mono uppercase tracking-wider text-muted">Classification</dt>
              <dd class="mt-1 font-medium text-ink">
                {formatTypeLabel(institution.type)} · {formatCategoryLabel(institution.category)}
              </dd>
            </div>
            <div>
              <dt class="font-mono uppercase tracking-wider text-muted">Est. Student Body</dt>
              <dd class="mt-1 font-mono font-semibold text-ink tabular-nums">
                ~{institution.estimated_student_count.toLocaleString()}
              </dd>
            </div>
            <div>
              <dt class="font-mono uppercase tracking-wider text-muted">Catalogued Tracks</dt>
              <dd class="mt-1 font-mono font-semibold text-ink tabular-nums">
                {institution.total_courses_count} programmes
              </dd>
            </div>
            <div>
              <dt class="font-mono uppercase tracking-wider text-muted">County &amp; Region</dt>
              <dd class="mt-1 text-ink">
                <a href={`/counties/${countySlug}`} class="text-forest hover:underline font-medium">
                  {institution.county}
                </a>{' '}
                ({institution.region})
              </dd>
            </div>
            <div>
              <dt class="font-mono uppercase tracking-wider text-muted">Google Maps</dt>
              <dd class="mt-1">
                <a
                  href={institution.google_maps_url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-mono text-lapis hover:underline"
                >
                  {institution.has_verified_maps_url ? 'Verified Maps Pin ↗' : 'Search Campus Map ↗'}
                </a>
              </dd>
            </div>
            <div>
              <dt class="font-mono uppercase tracking-wider text-muted">Public Registry Contact</dt>
              <dd class="mt-1 text-ink space-y-0.5">
                {institution.email && <div class="truncate">{institution.email}</div>}
                {institution.phone && <div class="font-mono text-muted">{institution.phone}</div>}
                {!institution.email && !institution.phone && (
                  <div>{institution.website ? 'See official website' : 'Via CUE / TVETA registry'}</div>
                )}
              </dd>
            </div>
          </dl>

          {institution.social_media.length > 0 && (
            <div class="pt-4 border-t border-hairline flex flex-wrap items-center gap-3 text-xs">
              <span class="font-mono uppercase tracking-wider text-muted">Official Channels:</span>
              {institution.social_media.map((s) => (
                <a
                  href={s.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="font-mono text-lapis hover:underline"
                >
                  {s.platform}: {s.handle} ↗
                </a>
              ))}
            </div>
          )}
        </section>

        <!-- Catalogued Courses Table -->
        <section class="border border-hairline bg-paper overflow-hidden">
          <div class="p-6 border-b border-hairline flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div>
              <p class="font-mono text-[11px] uppercase tracking-widest text-muted">
                Academic Offerings
              </p>
              <h2 class="font-serif text-2xl font-semibold text-ink mt-0.5">
                Accredited Programmes
              </h2>
            </div>
            <span class="font-mono text-xs text-muted tabular-nums">
              {institution.courses.length} catalogued tracks
            </span>
          </div>

          {institution.courses.length > 0 ? (
            <div class="overflow-x-auto">
              <table class="w-full text-left border-collapse text-sm">
                <thead>
                  <tr class="border-b border-hairline bg-limestone/50 font-mono text-[11px] uppercase tracking-wider text-muted">
                    <th class="py-3 px-4">Code / Body</th>
                    <th class="py-3 px-4">Programme Title</th>
                    <th class="py-3 px-4">Level</th>
                    <th class="py-3 px-4">Modality</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-hairline">
                  {institution.courses.slice(0, 60).map((course) => (
                    <tr>
                      <td class="py-3 px-4 font-mono text-xs text-forest font-semibold whitespace-nowrap">
                        {course.exam_body ?? course.code}
                      </td>
                      <td class="py-3 px-4 font-medium text-ink">{course.title}</td>
                      <td class="py-3 px-4 text-xs text-muted whitespace-nowrap">{course.level}</td>
                      <td class="py-3 px-4 text-xs text-muted whitespace-nowrap">{course.modality}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
              {institution.courses.length > 60 && (
                <p class="px-4 py-3 text-xs font-mono text-muted bg-limestone/30 border-t border-hairline">
                  Showing first 60 of {institution.courses.length} catalogued courses.
                </p>
              )}
            </div>
          ) : (
            <div class="p-6 text-sm text-muted">
              Specific programme catalogue entries for this institution are queued for verification in
              upcoming CUE / TVETA / NITA updates.
            </div>
          )}
        </section>

        <!-- Facilities & Accreditations -->
        <section class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="border border-hairline bg-paper p-6 space-y-3">
            <h3 class="font-serif text-xl font-semibold text-ink pb-2 border-b border-hairline">
              Facilities &amp; Labs
            </h3>
            {institution.facilities.length > 0 ? (
              <ul class="space-y-2 text-sm text-ink/90">
                {institution.facilities.map((fac) => (
                  <li class="flex items-start gap-2">
                    <span class="font-mono text-forest mt-0.5">·</span>
                    <span>{fac}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-xs text-muted leading-relaxed">
                Workshops, library holdings, and campus laboratory capacities not yet individually
                enumerated in the public registry.
              </p>
            )}
          </div>

          <div class="border border-hairline bg-paper p-6 space-y-3">
            <h3 class="font-serif text-xl font-semibold text-ink pb-2 border-b border-hairline">
              Accreditations &amp; Regulatory Standing
            </h3>
            {institution.accreditations.length > 0 ? (
              <ul class="space-y-2 text-sm text-ink/90">
                {institution.accreditations.map((acc) => (
                  <li class="flex items-start gap-2">
                    <span class="font-mono text-lapis mt-0.5">·</span>
                    <span>{acc}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-xs text-muted leading-relaxed">
                Supervised under Kenya’s statutory higher &amp; technical education frameworks (CUE,
                TVETA, KNEC, NITA, or Ministry of Health).
              </p>
            )}
            {institution.affiliation.length > 0 && (
              <div class="pt-3 border-t border-hairline text-xs text-muted">
                {institution.affiliation.map((aff) => (
                  <p>
                    <strong class="text-ink">{aff.body}</strong> — {aff.role}
                  </p>
                ))}
              </div>
            )}
          </div>
        </section>

        <!-- Campuses & Learning Modalities -->
        <section class="border border-hairline bg-paper p-6 space-y-4">
          <h3 class="font-serif text-xl font-semibold text-ink pb-2 border-b border-hairline">
            Campus Network &amp; Delivery Modalities
          </h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {institution.campuses.map((campus) => (
              <div class="border border-hairline bg-limestone/30 p-3 text-xs">
                <div class="flex items-center justify-between gap-2">
                  <span class="font-semibold text-ink">{campus.name}</span>
                  {campus.is_main && (
                    <span class="font-mono text-[10px] uppercase text-forest font-semibold">
                      Main
                    </span>
                  )}
                </div>
                <p class="text-muted mt-1">
                  {campus.town}, {campus.county} County
                </p>
              </div>
            ))}
          </div>

          <div class="pt-3 border-t border-hairline grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
            <div>
              <span class="font-mono uppercase tracking-wider text-muted block">E-Learning</span>
              <span class="text-ink font-medium mt-1 block">
                {institution.elearning_status !== 'none'
                  ? `${institution.elearning_status.toUpperCase()} — ${institution.elearning_notes}`
                  : 'Not indexed'}
              </span>
            </div>
            <div>
              <span class="font-mono uppercase tracking-wider text-muted block">Distance / ODeL</span>
              <span class="text-ink font-medium mt-1 block">
                {institution.distance_status !== 'none'
                  ? `${institution.distance_status.toUpperCase()} — ${institution.distance_notes}`
                  : 'Campus-based delivery'}
              </span>
            </div>
            <div>
              <span class="font-mono uppercase tracking-wider text-muted block">Teaching Practicum</span>
              <span class="text-ink font-medium mt-1 block">
                {institution.teaching_enabled ? institution.teaching_notes : 'Technical / Non-education focus'}
              </span>
            </div>
          </div>
        </section>
      </div>

      <!-- Right Column: Interactive Radar Island + Schologic LMS Access (4 cols) -->
      <aside class="lg:col-span-4 space-y-6">
        <InstitutionCompareIsland institution={institution} client:load />

        <div class="border border-hairline bg-limestone/45 p-5 space-y-3">
          <p class="font-mono text-[11px] uppercase tracking-widest text-muted">
            Schologic LMS Workspace
          </p>
          <h3 class="font-serif text-lg font-semibold text-ink">
            Student &amp; Instructor Access
          </h3>
          <p class="text-xs text-muted leading-relaxed">
            Access zero-cost OER textbooks in Universal Reader, or launch a free Schologic LMS
            instructor &amp; practicum workspace for {institution.name}.
          </p>
          <div class="pt-2 flex flex-col gap-2 text-xs">
            <a
              href={`/start?campus=${institution.slug}`}
              class="px-3.5 py-2 bg-forest text-paper font-semibold text-center hover:bg-ink transition-colors"
            >
              Launch Schologic LMS ({institution.slug}.schologic.org)
            </a>
            <a
              href={institution.google_maps_url}
              target="_blank"
              rel="noopener noreferrer"
              class="px-3.5 py-2 border border-hairline bg-paper text-ink font-semibold text-center hover:border-ink transition-colors"
            >
              Directions on Google Maps ↗
            </a>
            <a
              href="/oer"
              class="px-3.5 py-2 border border-hairline bg-paper text-ink font-semibold text-center hover:border-ink transition-colors"
            >
              Browse Free OER Textbooks
            </a>
          </div>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
