---
import BaseLayout from '../layouts/BaseLayout.astro';
import KenyaInteractiveMap from '../components/KenyaInteractiveMap';
import InstitutionRankingStudio from '../components/InstitutionRankingStudio';
import {
  CURATED_INSTITUTION_SUMMARIES,
  KENYA_47_COUNTIES,
  PUBLIC_INSTITUTIONS,
  getIndexedCounties,
} from '../data/publicInstitutions';

const totalInstitutions = PUBLIC_INSTITUTIONS.length;
const verifiedCount = PUBLIC_INSTITUTIONS.filter((i) => i.is_verified).length;
const totalCourses = PUBLIC_INSTITUTIONS.reduce((s, i) => s + i.total_courses_count, 0);
const indexedCountiesCount = getIndexedCounties().length;

const countyRegions: Record<string, string> = {};
for (const c of KENYA_47_COUNTIES) {
  countyRegions[c.county] = c.region;
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'schologic.org — Kenyan Educational Institutions Index',
  url: 'https://schologic.org',
  description:
    'Public Kenyan academic institutions index with full-width 47-county hover-zoom map, multi-criteria scoring and ranking visualization, and Schologic LMS portals.',
};
---

<BaseLayout
  title="schologic.org — Kenyan Academic Institutions Index & Interactive Map"
  description="Explore 2,300+ Kenyan universities, TVETs, National Polytechnics, and KMTC campuses on a full-width interactive 47-county map with hover zoom, integrative multi-criteria rankings, and Google Maps links."
  activeNav="index"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <div class="py-8 sm:py-10 space-y-12">
    <!-- Compelling Split Editorial Masthead -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-b border-hairline pb-10 grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <div class="lg:col-span-7 space-y-5">
        <p class="font-mono text-[11px] uppercase tracking-widest text-forest font-semibold">
          schologic.org · Kenya Higher &amp; Technical Education Registry
        </p>

        <h1 class="font-serif text-4xl sm:text-5xl font-semibold tracking-tight text-ink text-balance leading-[1.08]">
          Explore all 47 counties &amp; 2,300+ Kenyan institutions.
        </h1>

        <p class="text-base sm:text-lg text-muted leading-relaxed max-w-2xl">
          Navigate verified universities, National Polytechnics, TVET colleges, and KMTC campuses
          across Kenya. Hover over any county on the interactive atlas to zoom in, launch Google
          Maps directions, benchmark multi-criteria scores, or sign in to{' '}
          <strong class="text-ink font-semibold">Schologic LMS</strong>.
        </p>

        <div class="flex flex-wrap items-center gap-3 pt-1">
          <a
            href="#kenya-map"
            class="px-4 py-2.5 bg-forest text-paper text-sm font-semibold hover:bg-ink transition-colors whitespace-nowrap"
          >
            Explore 47-County Map
          </a>
          <a
            href="#ranking-studio"
            class="px-4 py-2.5 border border-ink bg-paper text-ink text-sm font-semibold hover:bg-ink hover:text-paper transition-colors whitespace-nowrap"
          >
            Interactive Ranking Studio
          </a>
          <a
            href="/directory"
            class="px-4 py-2.5 border border-hairline bg-limestone/50 text-ink text-sm font-semibold hover:border-ink transition-colors whitespace-nowrap"
          >
            Search All {totalInstitutions.toLocaleString()} Profiles →
          </a>
        </div>
      </div>

      <!-- Right: Structured Registry Almanac Panel -->
      <div class="lg:col-span-5 border border-hairline bg-paper p-5 sm:p-6 space-y-5">
        <div class="flex items-center justify-between pb-3 border-b border-hairline">
          <span class="font-mono text-[11px] uppercase tracking-widest text-muted">
            National Registry Almanac
          </span>
          <span class="font-mono text-[11px] text-forest font-semibold">
            CUE · TVETA · MoH
          </span>
        </div>

        <dl class="grid grid-cols-2 gap-4">
          <div class="border border-hairline bg-limestone/30 p-3.5">
            <dt class="font-mono text-[10px] uppercase tracking-wider text-muted">
              Active Institutions
            </dt>
            <dd class="font-serif text-2xl sm:text-3xl font-semibold text-ink tabular-nums mt-1">
              {totalInstitutions.toLocaleString()}
              <span class="font-mono text-xs font-normal text-muted block">Deduplicated public index</span>
            </dd>
          </div>
          <div class="border border-hairline bg-limestone/30 p-3.5">
            <dt class="font-mono text-[10px] uppercase tracking-wider text-muted">
              Counties Mapped
            </dt>
            <dd class="font-serif text-2xl sm:text-3xl font-semibold text-forest tabular-nums mt-1">
              {indexedCountiesCount} / 47
              <span class="font-mono text-xs font-normal text-muted block">8 Kenyan regions</span>
            </dd>
          </div>
          <div class="border border-hairline bg-limestone/30 p-3.5">
            <dt class="font-mono text-[10px] uppercase tracking-wider text-muted">
              Verified Registries
            </dt>
            <dd class="font-serif text-2xl font-semibold text-ink tabular-nums mt-1">
              {verifiedCount.toLocaleString()}
            </dd>
          </div>
          <div class="border border-hairline bg-limestone/30 p-3.5">
            <dt class="font-mono text-[10px] uppercase tracking-wider text-muted">
              Catalogued Programmes
            </dt>
            <dd class="font-serif text-2xl font-semibold text-ink tabular-nums mt-1">
              {totalCourses.toLocaleString()}
            </dd>
          </div>
        </dl>

        <div class="pt-3 border-t border-hairline flex flex-wrap items-center justify-between gap-2 text-xs">
          <span class="text-muted">Platform: <strong class="text-ink">Schologic LMS</strong></span>
          <div class="flex items-center gap-4 font-semibold">
            <a href="/oer" class="text-forest hover:underline">OER Library →</a>
            <a href="/login" class="text-lapis hover:underline">LMS Sign In →</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Section 1: FULL-WIDTH Interactive 47-County Geographic Map of Kenya -->
    <div id="kenya-map" class="w-full scroll-mt-20">
      <KenyaInteractiveMap
        initialInstitutions={CURATED_INSTITUTION_SUMMARIES}
        countyRegions={countyRegions}
        client:load
      />
    </div>

    <!-- Section 2: Integrative Multi-Criteria Scoring & Ranking Visualization -->
    <div id="ranking-studio" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 scroll-mt-20">
      <InstitutionRankingStudio
        initialInstitutions={CURATED_INSTITUTION_SUMMARIES}
        client:load
      />
    </div>

    <!-- Section 3: Practitioner & Schologic LMS Pathways -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <section class="border border-hairline bg-limestone/40 p-6 sm:p-8 grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
        <div class="lg:col-span-7 space-y-2">
          <p class="font-mono text-[11px] uppercase tracking-widest text-muted">
            Schologic LMS · For Students, Educators &amp; Registrars
          </p>
          <h2 class="font-serif text-2xl font-semibold text-ink">
            Free OER textbooks, instructor tools &amp; verified campus workspaces on Schologic LMS.
          </h2>
          <p class="text-sm text-muted leading-relaxed max-w-2xl">
            Browse the complete{' '}
            <a href="/directory" class="text-forest font-semibold hover:underline">
              {totalInstitutions.toLocaleString()}-institution directory
            </a>, study zero-cost texts in the{' '}
            <a href="/oer" class="text-forest font-semibold hover:underline">OER Library</a>, or launch
            a free course workspace via{' '}
            <a href="/start" class="text-forest font-semibold hover:underline">
              Schologic LMS Onboarding
            </a>.
          </p>
        </div>
        <div class="lg:col-span-5 flex flex-wrap lg:justify-end gap-2.5">
          <a
            href="/directory"
            class="px-4 py-2.5 border border-ink bg-paper text-ink text-xs sm:text-sm font-semibold hover:bg-ink hover:text-paper transition-colors whitespace-nowrap"
          >
            Browse Full Directory
          </a>
          <a
            href="/login"
            class="px-4 py-2.5 bg-forest text-paper text-xs sm:text-sm font-semibold hover:bg-ink transition-colors whitespace-nowrap"
          >
            Schologic LMS Login
          </a>
          <a
            href="/compare"
            class="px-4 py-2.5 border border-hairline bg-paper text-ink text-xs sm:text-sm font-semibold hover:border-ink transition-colors whitespace-nowrap"
          >
            Compare Radar
          </a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
